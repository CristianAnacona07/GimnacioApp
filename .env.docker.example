# Variables de la pila en contenedores (docker-compose.local.yml).
# Copia este archivo como .env EN LA RAIZ del repositorio y ajusta lo que necesites.
# No lo subas: .env esta en .gitignore.

# --- Obligatorio ---
# Clave con la que se firman los JWT. Cualquier cadena larga sirve en local.
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
# Contraseña del contenedor de Postgres de la propia pila. Cualquier cadena sirve en local.
POSTGRES_PASSWORD=cambia-esto-tambien

# --- Base de datos ---
# Por defecto usa el contenedor de Postgres de la propia pila y no hace falta
# tocar nada. Descomenta para apuntar a un Postgres externo (ej. el del VPS
# de produccion) en su lugar.
# DATABASE_URL=postgresql://usuario:password@host:5432/gymdb

# --- URL de la API que usara la web ---
# Se incrusta al compilar el frontend: si la cambias, reconstruye con
#   docker compose -f docker-compose.local.yml up -d --build frontend
# En un servidor propio seria https://api.tudominio.com
API_URL=http://localhost:10000

# --- Puertos del host (cambialos si chocan con otro proyecto) ---
FRONTEND_PORT=8090
BACKEND_PORT=10000
POSTGRES_PORT=5433
MAILPIT_SMTP_PORT=1026
MAILPIT_UI_PORT=8026
MINIO_PORT=9010
MINIO_CONSOLE_PORT=9011

# --- Almacen de archivos (fotos de la pagina publica de cada gimnasio) ---
# Credenciales del contenedor MinIO de la propia pila. Cambialas en produccion.
MINIO_ROOT_USER=gimnacio
MINIO_ROOT_PASSWORD=cambia-esto-en-produccion

# --- Google OAuth (opcional en local; sin esto el boton de Google da 500) ---
GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# --- Multi-tenant por subdominio (opcional) ---
TENANT_ROOT_DOMAIN=
