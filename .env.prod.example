# Configuración del servidor de producción (VPS).
#
#   cp .env.prod.example .env
#   nano .env          ← poner los valores reales
#   docker compose -f docker-compose.prod.yml up -d --build
#
# Este archivo (.env) NUNCA se sube al repositorio: contiene las claves.

# ── Dominio ───────────────────────────────────────────────────────────────
# Sin www y sin https://. Cada gimnasio quedará en <slug>.midominio.com
DOMINIO=midominio.com
# Correo para los avisos de vencimiento de certificados (Let's Encrypt).
EMAIL_CERTIFICADOS=tucorreo@ejemplo.com

# ── Secretos ──────────────────────────────────────────────────────────────
# Genera cada uno con:  openssl rand -base64 32
JWT_SECRET=
POSTGRES_DB=gymdb
POSTGRES_USER=gimnacio
POSTGRES_PASSWORD=
MINIO_USER=gimnacio
MINIO_PASSWORD=
S3_BUCKET=gimnacio

# ── Correo saliente ───────────────────────────────────────────────────────
# Con SMTP_HOST definido se usa ese servidor y se ignora Gmail.
# Ejemplo con Brevo: smtp-relay.brevo.com / 587
SMTP_HOST=
SMTP_PORT=587
EMAIL_USER=
EMAIL_PASS=
# ⚠️ CAMBIALO POR TU DOMINIO REAL. Un proveedor como Brevo rechaza todo correo
# cuyo remitente no sea de un dominio verificado en su panel (el que tiene los
# registros DKIM/DMARC en el DNS): dejar el ejemplo de abajo hace que ningún
# correo salga, ni el de recuperar contraseña. Si borrás esta línea, el
# docker-compose usa no-reply@<DOMINIO>, que suele ser lo correcto.
EMAIL_FROM=no-reply@midominio.com
# Opcional: solo si tu proveedor necesita forzar TLS. Vacío = se deduce del
# puerto (465 = TLS directo, 587 = STARTTLS).
SMTP_SECURE=

# ── Inicio de sesión con Google (opcional) ────────────────────────────────
# Hay que añadir https://midominio.com como origen autorizado en Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# ── Recibos por WhatsApp (opcional) ───────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
