DATABASE_URL=postgresql://usuario:password@host:5432/gymdb
JWT_SECRET=tu_clave_secreta_muy_larga
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
# Client ID del cliente OAuth Android (login nativo en la app Capacitor). Opcional.
GOOGLE_ANDROID_CLIENT_ID=tu_google_android_client_id.apps.googleusercontent.com
EMAIL_USER=tucuenta@gmail.com
EMAIL_PASS=tu_app_password_gmail
# --- Correo en DESARROLLO (Mailpit) ---
# Al definir SMTP_HOST el backend usa ese SMTP en vez de Gmail. Levantalo con:
#   docker compose -f docker-compose.local.yml up -d mailpit   (bandeja: http://localhost:8026)
# Mailpit no pide credenciales, asi que EMAIL_USER/EMAIL_PASS pueden quedar
# vacios en local. En produccion, con un SMTP que SI exija auth (Brevo,
# etc.), son esas MISMAS dos variables las que se usan — no hay un par
# SMTP_USER/SMTP_PASS aparte.
SMTP_HOST=
SMTP_PORT=1026
# SMTP_SECURE=true solo si el servidor exige TLS directo (Mailpit no).
SMTP_SECURE=
# Remitente de los correos. Por defecto usa EMAIL_USER.
EMAIL_FROM=
FRONTEND_URL=https://gimnacio-app.vercel.app
NODE_ENV=production
PORT=10000
# Multi-tenant por subdominio (opcional): dominio raiz de los gimnasios.
# Al definirlo, CORS acepta https://<slug>.TENANT_ROOT_DOMAIN (ej: sogafi.gimnasios.co)
# Dejar vacio o sin definir hasta comprar el dominio. Ver docs/SUBDOMINIOS.md
TENANT_ROOT_DOMAIN=
# Client ID del cliente OAuth iOS (login nativo en iPhone). Opcional.
GOOGLE_IOS_CLIENT_ID=tu_google_ios_client_id.apps.googleusercontent.com
